// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  passwordHash        String
  resetToken          String?
  resetTokenExpiry    DateTime?
  refreshToken        String?          @unique  // SHA-256 hash of the issued refresh token
  refreshTokenExpiry  DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  goals               Goal[]
  eisenhowerTasks     EisenhowerTask[]
  backlogItems        BacklogItem[]
  pushTokens          PushToken[]

  @@index([email])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // 'ios' | 'android'
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model NotificationLog {
  id     String   @id @default(uuid())
  goalId String
  goal   Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date   String   // "YYYY-MM-DD" in user's local timezone
  type   String   // 'goal_start'
  sentAt DateTime @default(now())

  @@unique([goalId, date, type])
  @@index([date])
}

model Goal {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  startTime       String    // "07:00" format
  endTime         String    // "07:30" format
  allocatedMinutes Int
  tags            String[]  @default([])
  createdAt       DateTime  @default(now())
  targetEndDate  String?   // "2025-03-15" format
  isWeekendGoal  Boolean   @default(false)
  isWeekdayGoal  Boolean   @default(false)
  completedAt     DateTime? // When goal was completed
  dayEntries        DayEntry[]
  notificationLogs  NotificationLog[]

  @@index([userId])
  @@index([createdAt])
  @@index([completedAt])
}

model DayEntry {
  id            String   @id @default(uuid())
  goalId        String
  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date          String   // "2025-01-15" format
  status        String   // 'hit' | 'miss' | 'partial'
  actualMinutes Int      @default(0)
  comment       String   @default("")
  missedReason  String?
  timeBlocks    Json     // Array of TimeBlock objects
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([goalId, date])
  @@index([goalId])
  @@index([date])
}

model EisenhowerTask {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  quadrant    String   // 'do-first' | 'schedule' | 'delegate' | 'eliminate'
  delegateTo  String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([quadrant])
  @@index([completedAt])
}

model BacklogItem {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  category          String    // 'certifications' | 'udemy' | 'books' | 'interview' | 'concepts'
  priority          String    // 'high' | 'medium' | 'low'
  tentativeStartDate String   // "2025-03-15" format
  estimatedHours    Int?
  completedAt       DateTime?
  sortOrder         Int       @default(0) // per-category manual ordering
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([userId])
  @@index([category])
  @@index([priority])
  @@index([completedAt])
  @@index([userId, category, sortOrder])
}
