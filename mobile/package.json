{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "expo": "~56.0.8",
    "expo-audio": "~56.0.11",
    "expo-constants": "~56.0.16",
    "expo-font": "~56.0.5",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.13",
    "expo-notifications": "~56.0.15",
    "expo-router": "~56.2.8",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lucide-react-native": "^1.17.0",
    "nativewind": "^4.2.4",
    "react": "19.2.3",
    "react-hook-form": "^7.77.0",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^56.0.14",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.4",
    "react-test-renderer": "^19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ]
  },
  "scripts": {
    "test": "jest",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "expo:prebuild": "expo prebuild --no-install --clean",
    "expo:prebuild:android": "expo prebuild --platform android --no-install --clean",
    "expo:prebuild:ios": "expo prebuild --platform ios --no-install --clean",
    "build:android": "export $(grep -v '^#' .env | grep '=' | xargs) && rm -rf android && expo prebuild --no-install --clean && cd android && chmod +x gradlew && ./gradlew assembleRelease --no-daemon",
    "build:android:prod": "EXPO_PUBLIC_API_URL=https://turinghatch.com/ruthless-execution/api npm run build:android",
    "build:ios": "xcodebuild -workspace ios/ruthless-execution.xcworkspace -scheme ruthless-execution -configuration Release -sdk iphoneos -destination 'generic/platform=iOS' archive -archivePath ios/build/ruthless-execution.xcarchive CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO"
  },
  "private": true
}
